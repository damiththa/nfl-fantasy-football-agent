      "dot": "emerald",
      "title": "External Data Sources (6 APIs)",
      "items": [
        "ESPN Fantasy v3 Private API: Rosters, matchups, box scores, free agents (authenticated via S2/SWID cookies)",
        "ESPN Scoreboard API: Vegas spreads, over/under totals, implied team totals for game-script strategy",
        "Sleeper API: Real-time trending adds/drops (market velocity) and NFL injury practice reports",
        "Open-Meteo Weather API: Stadium-specific forecasts with wind, precipitation, and temperature data"
      ]
    },
