# =============================================================================
# NFL Fantasy Football Agent — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# =============================================================================

# ESPN Fantasy API Cookies
# Get from browser DevTools → Application → Cookies → espn.com
ESPN_S2="your_espn_s2_cookie_here"
ESPN_SWID="your_swid_cookie_here"

# ESPN League IDs
ESPN_LEAGUE_ID_1="991059191"
ESPN_LEAGUE_ID_2="735288"

# Your team ID in each league
ESPN_TEAM_ID_1="3"
ESPN_TEAM_ID_2="3"

# Gemini API Key (from Google AI Studio — free tier)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# Season
NFL_SEASON="2026"
